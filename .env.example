DATABASE_URL="postgresql://teams_observer:teams_observer@localhost:5432/teams_discovery_observer?schema=public"
REDIS_URL="redis://localhost:6379"

NEXT_PUBLIC_APP_NAME="Teams Discovery Observer"
APP_BASE_URL="http://localhost:3000"

AZURE_TENANT_ID=""
AZURE_CLIENT_ID=""
AZURE_CLIENT_SECRET=""
GRAPH_CLIENT_STATE="replace-with-long-random-secret"
GRAPH_WEBHOOK_URL="https://your-public-url.example.com/api/graph/webhook"
AZURE_REDIRECT_URI="http://localhost:3000/api/graph/auth/callback"
GRAPH_DELEGATED_SCOPES="User.Read Chat.ReadBasic Chat.Read"

LOCAL_AI_BASE_URL="http://localhost:11434/v1"
LOCAL_AI_MODEL="llama3.1"
LOCAL_AI_API_KEY=""

CLAUDE_CODE_COMMAND="claude"
CLAUDE_CODE_WORKDIR="/tmp/teams-discovery-observer-agent"
CLAUDE_CODE_TIMEOUT_MS="120000"

# Meeting assistant — speaker diarization of the "others" channel. Opt-in: set to
# "true" to enable. Enabling downloads a speaker-embedding model to the cache dir on
# first use.
MEETING_CAPTURE_DIARIZATION="false"
MEETING_DIARIZATION_MODEL="Xenova/wavlm-base-plus-sv"
MEETING_DIARIZATION_SIMILARITY_THRESHOLD="0.86"
MEETING_DIARIZATION_MODEL_CACHE=""
