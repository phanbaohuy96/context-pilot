DATABASE_URL="postgresql://teams_observer:teams_observer@localhost:5432/teams_discovery_observer?schema=public"
REDIS_URL="redis://localhost:6379"

NEXT_PUBLIC_APP_NAME="ContextPilot"
APP_BASE_URL="http://localhost:3000"

AZURE_TENANT_ID=""
AZURE_CLIENT_ID=""
AZURE_CLIENT_SECRET=""
GRAPH_CLIENT_STATE="replace-with-long-random-secret"
GRAPH_WEBHOOK_URL="https://your-public-url.example.com/api/graph/webhook"
AZURE_REDIRECT_URI="http://localhost:3000/api/graph/auth/callback"
GRAPH_DELEGATED_SCOPES="User.Read Chat.ReadBasic Chat.Read"

SETTINGS_ENCRYPTION_KEY="replace-with-long-random-settings-secret"

# Meeting assistant feature toggles are configured per tenant on /settings, not via env:
#   - Rolling meeting notes
#   - Speaker diarization of the "others" channel (downloads a model on first use)
#   - Transcript correction (merging fragmented same-speaker lines)
# All three reuse the meeting AI provider selected on /settings.

# --- Meeting capture: advanced per-machine tuning (optional; sensible defaults in code) ---

# Diarization model tuning (only relevant when diarization is enabled on /settings).
MEETING_DIARIZATION_MODEL="Xenova/wavlm-base-plus-sv"
MEETING_DIARIZATION_SIMILARITY_THRESHOLD="0.86"
MEETING_DIARIZATION_MODEL_CACHE=""

# Replay a recording through the live capture pipeline instead of a microphone/loopback
# device: set MEETING_CAPTURE_FFMPEG_FORMAT to a file demuxer (e.g. "mp4") and pass the
# file path as the capture source. By default a file is read as fast as the disk allows,
# collapsing the whole recording into a couple of utterances; set INPUT_REALTIME="true" to
# pace it at native rate so capture fragments and finalizes like a live meeting. Leave both
# unset for normal device capture (format defaults to avfoundation on macOS).
MEETING_CAPTURE_FFMPEG_FORMAT="avfoundation"
MEETING_CAPTURE_FFMPEG_INPUT_REALTIME="false"

# Rolling notes regenerate every N new finalized utterances (the notes toggle itself is on /settings).
MEETING_NOTES_MIN_NEW_UTTERANCES="6"
